@model List<RPA.Inspections.Workbench.Models.PackRequested>


@{
    ViewBag.Title = "PacksRequested";
}



<div class="float-right">
    <button style="position:static;" onclick="location.href='@Url.Action("Index", "Home")'">Home</button>
</div>
<br />


<h3>Outstanding Packs Requested</h3>



<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model[0].Holding.cphNumber)
        </th>

        <th>
            @Html.DisplayNameFor(model => model[0].Holding.primaryName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model[0].Holding.region)
        </th>
        <th>
            @Html.DisplayNameFor(model =>model[0].datePackRequested)
        </th>
    </tr>

    @foreach (var item in Model)
    {
        <tr id=@item.holdingId>
            <td align="center">
                @Html.DisplayFor(modelItem => item.Holding.cphNumber)
            </td>
            <td align="center">
                @Html.DisplayFor(modelItem => item.Holding.primaryName)
            </td>
            <td align="center">
                @Html.DisplayFor(modelItem => item.Holding.region)
            </td>
            <td align="center">
                @Html.DisplayFor(modelItem => item.datePackRequested)
            </td>
            @Html.HiddenFor(modelItem => item.packRequestedId)
        </tr>
    }
</table>

<div>
    @{
        Html.RenderAction("_GeneratedPacks", "Holding");
    }
</div>