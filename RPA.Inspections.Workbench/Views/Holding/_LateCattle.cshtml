@model List<RPA.Inspections.Workbench.Models.Cattle>



@if (Model.Count != 0)
{

    <table border="1" align="center" style="padding-top:2em">
        <tr style="text-align:center">
            <td style="font-weight:bold">@Html.DisplayNameFor(model => model[0].lateNotification)</td>
            <td style="font-weight:bold">@Html.DisplayNameFor(model => model[0].lateType)</td>
            <td style="font-weight:bold">@Html.DisplayNameFor(model => model[0].earTag)</td>
            <td style="font-weight:bold">@Html.DisplayNameFor(model => model[0].Breed.breedCode)</td>
            <td style="font-weight:bold">@Html.DisplayNameFor(model => model[0].passportVersion)</td>
            <td style="font-weight:bold">@Html.DisplayNameFor(model => model[0].gender)</td>
            <td style="font-weight:bold">@Html.DisplayNameFor(model => model[0].birthDate)</td>
            <td style="font-weight:bold">@Html.DisplayNameFor(model => model[0].onDate)</td>
            <td style="font-weight:bold">@Html.DisplayNameFor(model => model[0].damId)</td>
            <td style="font-weight:bold">@Html.DisplayNameFor(model => model[0].offDate)</td>
            <td style="font-weight:bold">@Html.DisplayNameFor(model => model[0].deathDate)</td>
            <td style="font-weight:bold">@Html.DisplayNameFor(model => model[0].lateDate)</td>
            <td style="font-weight:bold">@Html.DisplayNameFor(model => model[0].notificationDate)</td>
            <td style="font-weight:bold">@Html.DisplayNameFor(model => model[0].numberOfDaysLate)</td>

        </tr>

        @foreach (var item in Model)

        {
            <tr style="text-align:center">
                <td>@Html.DisplayFor(model => item.lateDisplay)</td>
                <td>@Html.DisplayFor(model => item.lateType)</td>
                <td>@Html.DisplayFor(model => item.earTag)</td>
                <td>@Html.DisplayFor(model => item.Breed.breedCode)</td>
                <td>@Html.DisplayFor(model => item.passportVersion)</td>
                <td>@Html.DisplayFor(model => item.gender)</td>
                <td>@Html.DisplayFor(model => item.birthDate)</td>
                <td>@Html.DisplayFor(model => item.onDate)</td>
                <td>@Html.DisplayFor(model => item.damId)</td>
                <td>@Html.DisplayFor(model => item.offDate)</td>
                <td>@Html.DisplayFor(model => item.deathDate)</td>
                <td>@Html.DisplayFor(model => item.lateDate)</td>
                <td>@Html.DisplayFor(model => item.notificationDate)</td>
                <td>@Html.DisplayFor(model => item.numberOfDaysLate)</td>
            </tr>

        }

    </table>

    }

