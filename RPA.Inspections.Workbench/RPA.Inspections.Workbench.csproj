<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>RPA.Inspections.Workbench</RootNamespace>
    <AssemblyName>RPA.Inspections.Workbench</AssemblyName>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.5.2" />
    <PackageReference Include="EPPlus" Version="4.5.3.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.13" />
    <PackageReference Include="X.PagedList.Mvc.Core" Version="10.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Files that were on disk but never part of the original project -->
    <Compile Remove="Migrations\201902061506248_test.cs" />
    <Compile Remove="Migrations\201902061506248_test.Designer.cs" />
    <Compile Remove="Migrations\Interfaces\**" />
    <Compile Remove="Services\IExcelWrapper.cs" />
    <Compile Remove="Services\LateCattleCalculator.cs" />
    <EmbeddedResource Remove="Migrations\201611301409238_schemeyear.resx" />
    <EmbeddedResource Remove="Migrations\201612011341580_packgen.resx" />
    <EmbeddedResource Remove="Migrations\201612011431210_tesst.resx" />
    <EmbeddedResource Remove="Migrations\201612011433028_bytey.resx" />
    <EmbeddedResource Update="Migrations\*.resx">
      <DependentUpon>%(Filename).cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Excel templates used to build inspection packs; resolved from the application base directory -->
    <None Update="Uploads\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>


