<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>RPA.Inspections.Workbench</RootNamespace>
    <AssemblyName>RPA.Inspections.Workbench</AssemblyName>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="EntityFramework" Version="6.4.4" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
    <PackageReference Include="EPPlus" Version="4.5.3.3" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.1" />
    <!-- Pin the patched version rather than Identity.Web's vulnerable transitive minimum. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="X.PagedList.Mvc.Core" Version="10.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Historical migrations are deployment-managed and never replayed at startup. -->
    <Compile Remove="Migrations\**" />
    <EmbeddedResource Remove="Migrations\**" />
    <!-- Files that were on disk but never part of the original project -->
    <Compile Remove="Services\IExcelWrapper.cs" />
    <Compile Remove="Services\LateCattleCalculator.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the read-only template, never historical generated inspection packs. -->
    <None Update="Uploads\**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="Uploads\CII Animal Data Spreadsheet v2.2.xlsm" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
